{
  "name": "mihrab-methods",
  "version": "1.9.0",
  "description": "The prayer-time authorities' own calculation methods, each reproducing its published timetable to the minute: Sweden (Diyanet, as Islamiska Förbundet prints it), Diyanet worldwide, Morocco (Habous), Algeria (Ministry of Religious Affairs), Indonesia (Kemenag), Türkiye Takvimi, Kazakhstan (Spiritual Administration), Egypt (General Authority of Survey), Brunei (Ministry of Religious Affairs), Qatar (Qatar Calendar House), Kuwait (Ministry of Awqaf and Islamic Affairs).",
  "license": "MPL-2.0",
  "author": "Hassan El Ghamri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MihrabHQ/mihrab-methods.git"
  },
  "homepage": "https://github.com/MihrabHQ/mihrab-methods#readme",
  "bugs": "https://github.com/MihrabHQ/mihrab-methods/issues",
  "keywords": [
    "prayer times",
    "salah",
    "namaz",
    "diyanet",
    "habous",
    "kemenag",
    "islamiska förbundet",
    "adhan",
    "mihrab"
  ],
  "sideEffects": [
    "./dist/*/index.js",
    "./dist/*/sweden.js",
    "./dist/*/diyanet.js",
    "./dist/*/morocco.js",
    "./dist/*/algeria.js",
    "./dist/*/indonesia.js",
    "./dist/*/turkiyetakvimi.js",
    "./dist/*/kazakhstan.js",
    "./dist/*/egypt.js",
    "./dist/*/brunei.js",
    "./dist/*/qatar.js",
    "./dist/*/kuwait.js",
    "./dist/*/authorities/*.js",
    "./src/index.ts",
    "./src/sweden.ts",
    "./src/diyanet.ts",
    "./src/morocco.ts",
    "./src/algeria.ts",
    "./src/indonesia.ts",
    "./src/turkiyetakvimi.ts",
    "./src/kazakhstan.ts",
    "./src/egypt.ts",
    "./src/brunei.ts",
    "./src/qatar.ts",
    "./src/kuwait.ts",
    "./src/authorities/*.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "schemas",
    "docs/methods.md",
    "certification.json",
    "data/corrections"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/esm/core.d.ts",
        "default": "./dist/esm/core.js"
      },
      "require": {
        "types": "./dist/cjs/core.d.ts",
        "default": "./dist/cjs/core.js"
      }
    },
    "./sweden": {
      "import": {
        "types": "./dist/esm/sweden.d.ts",
        "default": "./dist/esm/sweden.js"
      },
      "require": {
        "types": "./dist/cjs/sweden.d.ts",
        "default": "./dist/cjs/sweden.js"
      }
    },
    "./diyanet": {
      "import": {
        "types": "./dist/esm/diyanet.d.ts",
        "default": "./dist/esm/diyanet.js"
      },
      "require": {
        "types": "./dist/cjs/diyanet.d.ts",
        "default": "./dist/cjs/diyanet.js"
      }
    },
    "./morocco": {
      "import": {
        "types": "./dist/esm/morocco.d.ts",
        "default": "./dist/esm/morocco.js"
      },
      "require": {
        "types": "./dist/cjs/morocco.d.ts",
        "default": "./dist/cjs/morocco.js"
      }
    },
    "./algeria": {
      "import": {
        "types": "./dist/esm/algeria.d.ts",
        "default": "./dist/esm/algeria.js"
      },
      "require": {
        "types": "./dist/cjs/algeria.d.ts",
        "default": "./dist/cjs/algeria.js"
      }
    },
    "./indonesia": {
      "import": {
        "types": "./dist/esm/indonesia.d.ts",
        "default": "./dist/esm/indonesia.js"
      },
      "require": {
        "types": "./dist/cjs/indonesia.d.ts",
        "default": "./dist/cjs/indonesia.js"
      }
    },
    "./turkiyetakvimi": {
      "import": {
        "types": "./dist/esm/turkiyetakvimi.d.ts",
        "default": "./dist/esm/turkiyetakvimi.js"
      },
      "require": {
        "types": "./dist/cjs/turkiyetakvimi.d.ts",
        "default": "./dist/cjs/turkiyetakvimi.js"
      }
    },
    "./kazakhstan": {
      "import": {
        "types": "./dist/esm/kazakhstan.d.ts",
        "default": "./dist/esm/kazakhstan.js"
      },
      "require": {
        "types": "./dist/cjs/kazakhstan.d.ts",
        "default": "./dist/cjs/kazakhstan.js"
      }
    },
    "./egypt": {
      "import": {
        "types": "./dist/esm/egypt.d.ts",
        "default": "./dist/esm/egypt.js"
      },
      "require": {
        "types": "./dist/cjs/egypt.d.ts",
        "default": "./dist/cjs/egypt.js"
      }
    },
    "./brunei": {
      "import": {
        "types": "./dist/esm/brunei.d.ts",
        "default": "./dist/esm/brunei.js"
      },
      "require": {
        "types": "./dist/cjs/brunei.d.ts",
        "default": "./dist/cjs/brunei.js"
      }
    },
    "./qatar": {
      "import": {
        "types": "./dist/esm/qatar.d.ts",
        "default": "./dist/esm/qatar.js"
      },
      "require": {
        "types": "./dist/cjs/qatar.d.ts",
        "default": "./dist/cjs/qatar.js"
      }
    },
    "./kuwait": {
      "import": {
        "types": "./dist/esm/kuwait.d.ts",
        "default": "./dist/esm/kuwait.js"
      },
      "require": {
        "types": "./dist/cjs/kuwait.d.ts",
        "default": "./dist/cjs/kuwait.js"
      }
    },
    "./locate": {
      "import": {
        "types": "./dist/esm/locate.d.ts",
        "default": "./dist/esm/locate.js"
      },
      "require": {
        "types": "./dist/cjs/locate.d.ts",
        "default": "./dist/cjs/locate.js"
      }
    },
    "./certification.json": "./certification.json",
    "./data/corrections/*.json": "./data/corrections/*.json",
    "./schemas/*.json": "./schemas/*.json",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/cjs/core.d.ts"
      ],
      "sweden": [
        "./dist/cjs/sweden.d.ts"
      ],
      "diyanet": [
        "./dist/cjs/diyanet.d.ts"
      ],
      "morocco": [
        "./dist/cjs/morocco.d.ts"
      ],
      "algeria": [
        "./dist/cjs/algeria.d.ts"
      ],
      "indonesia": [
        "./dist/cjs/indonesia.d.ts"
      ],
      "turkiyetakvimi": [
        "./dist/cjs/turkiyetakvimi.d.ts"
      ],
      "kazakhstan": [
        "./dist/cjs/kazakhstan.d.ts"
      ],
      "egypt": [
        "./dist/cjs/egypt.d.ts"
      ],
      "brunei": [
        "./dist/cjs/brunei.d.ts"
      ],
      "qatar": [
        "./dist/cjs/qatar.d.ts"
      ],
      "kuwait": [
        "./dist/cjs/kuwait.d.ts"
      ],
      "locate": [
        "./dist/cjs/locate.d.ts"
      ]
    }
  },
  "scripts": {
    "embed": "node scripts/embed.mjs",
    "build": "npm run embed && rm -rf dist && tsc -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "prepack": "npm run build",
    "pretest": "npm run embed",
    "test": "tsx --test test/*.test.ts",
    "pretypecheck": "npm run embed",
    "typecheck": "tsc --noEmit",
    "preverify": "npm run embed",
    "verify": "tsx tools/verify.ts",
    "precorrections": "npm run embed",
    "corrections": "tsx tools/corrections.ts",
    "precertify": "npm run embed",
    "certify": "tsx tools/certify.ts",
    "vectors": "npm run embed && tsx tools/vectors.ts",
    "port-sample": "npm run embed && tsx tools/port-sample.ts",
    "prefeed-check": "npm run embed",
    "feed-check": "tsx tools/feed-check.ts",
    "readme": "node scripts/readme.mjs",
    "preflight": "npm run typecheck && npm test && node scripts/readme.mjs --check",
    "serve": "npm run embed && tsx tools/serve.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
