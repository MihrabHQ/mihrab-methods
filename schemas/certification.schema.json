{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MihrabHQ/mihrab-methods/main/schemas/certification.schema.json",
  "title": "mihrab-methods certification",
  "description": "What may be used: for each authority, whether its method reproduces every time of the authority's tables on the printed minute, over which dates, at which method revision, and which correction list that holds with. Written by `npm run certify`; read by apps to keep current (fetchLatestCorrections).",
  "type": "object",
  "propertyNames": {
    "enum": [
      "sweden",
      "diyanet",
      "morocco",
      "algeria",
      "indonesia"
    ]
  },
  "additionalProperties": {
    "$ref": "#/$defs/entry"
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "entry": {
      "type": "object",
      "required": [
        "certified",
        "checkedAt",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "certified": {
          "type": "boolean",
          "description": "True only when every check below has every time on the printed minute. Not trusted alone: apps re-derive it from the checks."
        },
        "checkedAt": {
          "$ref": "#/$defs/date"
        },
        "places": {
          "type": "integer",
          "minimum": 0,
          "description": "How many places the library offers for the authority (the checks say how many were compared)."
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "corrections": {
          "type": "object",
          "description": "The correction list this certification is for: its identity, and the SHA-256 of data/corrections/<authority>.json as published.",
          "required": [
            "from",
            "to",
            "entries"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/date"
            },
            "to": {
              "$ref": "#/$defs/date"
            },
            "entries": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "The method's revision the list is for. An app computing another revision must not apply the list."
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "tables",
        "places",
        "times",
        "off",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "tables": {
          "type": "string",
          "description": "Whose tables were checked."
        },
        "places": {
          "type": "integer",
          "minimum": 0
        },
        "times": {
          "type": "integer",
          "minimum": 0
        },
        "off": {
          "type": "integer",
          "minimum": 0,
          "description": "Times not on the printed minute. Certified only at 0."
        },
        "from": {
          "$ref": "#/$defs/date"
        },
        "to": {
          "$ref": "#/$defs/date"
        },
        "setAside": {
          "type": "object",
          "description": "Rows set aside as the source's fault, not the method's, so each can be judged.",
          "required": [
            "misplaced",
            "sourceFaults",
            "copiedRows"
          ],
          "additionalProperties": false,
          "properties": {
            "misplaced": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sourceFaults": {
              "type": "integer",
              "minimum": 0
            },
            "copiedRows": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "offWithoutCorrections": {
          "type": "integer",
          "minimum": 0,
          "description": "Of the same times, how many the method alone, without its correction list, leaves off the printed minute."
        }
      }
    }
  }
}
